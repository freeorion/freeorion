[configuration]

entry_symbol = "freeorion_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]
macos.debug = "./libfreeoriongodot.dylib"
macos.release = "./libfreeoriongodot.dylib"
linux.debug.x86_64 = "./linux.64/libfreeoriongodot.so"
linux.release.x86_64 = "./linux.64/libfreeoriongodot.so"
android.debug.arm32 = "./android.armeabi-v7a.32/libfreeoriongodot.so"
android.release.arm32 = "./android.armeabi-v7a.32/libfreeoriongodot.so"
android.debug.arm64 = "./android.arm64-v8a.64/libfreeoriongodot.so"
android.release.arm64 = "./android.arm64-v8a.64/libfreeoriongodot.so"
android.debug.x86_32 = "./android.x86.32/libfreeoriongodot.so"
android.release.x86_32 = "./android.x86.32/libfreeoriongodot.so"
android.debug.x86_64 = "./android.x86_64.64/libfreeoriongodot.so"
android.release.x86_64 = "./android.x86_64.64/libfreeoriongodot.so"

[dependencies]
android.debug.arm32 = { "./android.armeabi-v7a.32/libiconv.so": "" }
android.release.arm32 = { "./android.armeabi-v7a.32/libiconv.so": "" }
android.debug.arm64 = { "./android.arm64-v8a.64/libiconv.so": "" }
android.release.arm64 = { "./android.arm64-v8a.64/libiconv.so": "" }
android.debug.x86_32 = { "./android.x86.32/libiconv.so": "" }
android.release.x86_32 = { "./android.x86.32/libiconv.so": "" }
android.debug.x86_64 = { "./android.x86_64.64/libiconv.so": "" }
android.release.x86_64 = { "./android.x86_64.64/libiconv.so": "" }
